# Port for the agent's local HTTP server
AGENT_PORT=7842

# Generate with: openssl rand -hex 32
AGENT_SECRET=

# Chrome CDP endpoint
CDP_ENDPOINT=http://127.0.0.1:9222

# Naukri profile URL
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile

# Naukri email (non-sensitive)
NAUKRI_EMAIL=

# Next.js web gateway on localhost (for reporting heartbeats, runs, and fetching schedule)
WEB_GATEWAY_URL=http://127.0.0.1:3000

# Optional custom config directory (defaults to ~/.config/NaukriUpdate on Linux)
# NAUKRI_CONFIG_DIR=
