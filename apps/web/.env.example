# Web application environment variables
# Copy to .env.local — never commit .env.local

# ── Supabase (public — safe for browser) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (private — server only, never expose to browser) ────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Agent connection (server only) ──────────────────────────────
# URL of the local agent HTTP server
AGENT_URL=http://127.0.0.1:7842
# Shared secret matching the agent's AGENT_SECRET
# Generate with: openssl rand -hex 32
AGENT_SECRET=your-shared-secret

# ── Agent User Association (server only) ────────────────────────
# Local association/configuration value mapping local agent reports to a user.
# NOT an authentication or authorization boundary; browser user identity is ALWAYS derived server-side from session.
# AGENT_USER_ID=your-supabase-user-uuid
