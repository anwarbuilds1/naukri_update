# Naukri Profile Refresh
# The dedicated local Chrome profile retains the authenticated Naukri session.
# Add native Naukri credentials only to your private .env; they are intentionally
# omitted from this template so no credential value is documented or committed.
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile
NAUKRI_EMAIL=your-email@gmail.com
NAUKRI_PASSWORD=your-password
